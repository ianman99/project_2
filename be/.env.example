MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dxschool?retryWrites=true&w=majority
MONGODB_DB=dxschool

# 인증코드 발송 — Supabase Auth가 보낸다 (연결된 네이버 SMTP가 실제 발송).
# 비워 두면 발송하지 않고 어드민이 코드를 직접 발급한다 (PRD F-1.9).
# secret 키는 필요 없다. publishable 키만 쓴다.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 서버
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# 인증
SESSION_SECRET=<openssl rand -hex 32 등으로 생성>
ADMIN_STUDENT_NO=6155

# AI 매칭
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.6-terra
MATCH_COST=1000

# 배포 시에만 설정 — 프론트 빌드본을 같은 서버에서 서빙한다
# STATIC_DIR=../fe/dist
