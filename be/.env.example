MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dxschool?retryWrites=true&w=majority
MONGODB_DB=dxschool

# 메일 발송 — RESEND_API_KEY가 있으면 Resend HTTP API를 쓰고 SMTP_*는 무시한다.
# Render 무료 플랜은 SMTP 포트(25·465·587)를 막으므로 배포 환경에서는 Resend를 쓴다.
# Resend를 쓸 때 MAIL_FROM_ADDRESS는 Resend에 인증된 도메인이어야 한다.
# RESEND_API_KEY=re_...

# 네이버 SMTP — 포트 587 STARTTLS (로컬 개발용)
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USER=<네이버 아이디>
SMTP_PASS=<애플리케이션 비밀번호>
MAIL_FROM_ADDRESS=<네이버 아이디>@naver.com
MAIL_FROM_NAME=사랑찾아 인생찾아

# 서버
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# 인증
SESSION_SECRET=<openssl rand -hex 32 등으로 생성>
ADMIN_STUDENT_NO=6155

# AI 매칭
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.6-terra
MATCH_COST=1000

# 배포 시에만 설정 — 프론트 빌드본을 같은 서버에서 서빙한다
# STATIC_DIR=../fe/dist
